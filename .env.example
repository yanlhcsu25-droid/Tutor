CALCULUS_AGENT_DATABASE_URL=sqlite:///./calculus_agent.db
CALCULUS_AGENT_PHASE2C_ENABLED=false
AGENT_DYNAMIC_TOOL_SELECTION_ENABLED=false
CALCULUS_AGENT_OCR_PAGE_TIMEOUT_SECONDS=300
CALCULUS_AGENT_OCR_PAGE_RSS_LIMIT_MB=8192
CALCULUS_AGENT_PDF_ENGINE=auto
CALCULUS_AGENT_PDF_COMPILE_TIMEOUT_SECONDS=60
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_AGENT_MODEL=zai-org/GLM-4.5V
SILICONFLOW_VL_MODEL=zai-org/GLM-4.5V
SILICONFLOW_TIMEOUT_SECONDS=120

# Langfuse observability (https://cloud.langfuse.com or your self-hosted URL)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=local

CALCULUS_AGENT_KNOWLEDGE_LLM_ENABLED=false
